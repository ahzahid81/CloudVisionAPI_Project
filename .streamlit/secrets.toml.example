# Copy this file to .streamlit/secrets.toml and fill in your service account key.
# Never commit the real secrets.toml file.

# Optional: require a password before visitors can use the app.
# app_password = "choose-a-strong-password"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "vision-app@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/vision-app%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
